# Authentication (Neon Managed Better Auth)
NEON_AUTH_BASE_URL=
# Optional explicit cookie secret. If omitted, LeetSolve derives one server-side from DATABASE_URL.
NEON_AUTH_COOKIE_SECRET=

# AI (shared Groq provider)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Neon PostgreSQL
DATABASE_URL=

# Optional code judge (Judge0-compatible)
JUDGE0_URL=
JUDGE0_API_KEY=
JUDGE0_API_HOST=

# Optional legacy cron endpoint protection
CRON_SECRET=

# Solver settings
DEFAULT_LANGUAGE=java
MAX_REPAIR_ATTEMPTS=2
