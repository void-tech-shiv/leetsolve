# AI (Groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# LeetCode account server secrets
# Treat these like passwords. Never expose them to browser code or commit real values.
LEETCODE_SESSION=
LEETCODE_CSRF=

# Neon PostgreSQL
DATABASE_URL=

# Optional code judge (Judge0-compatible)
JUDGE0_URL=
JUDGE0_API_KEY=
JUDGE0_API_HOST=

# Optional key for protected dashboard actions
APP_ACCESS_KEY=

# Solver settings
DEFAULT_LANGUAGE=java
MAX_REPAIR_ATTEMPTS=2
