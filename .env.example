# Authentication (Neon Managed Better Auth)
NEON_AUTH_BASE_URL=
# Optional explicit cookie secret. If omitted, LeetSolve derives one server-side from DATABASE_URL.
NEON_AUTH_COOKIE_SECRET=

# AI model only. Every user supplies their own Groq API key in the dashboard.
GROQ_MODEL=openai/gpt-oss-120b

# Neon PostgreSQL
DATABASE_URL=

# Required for per-user LeetCode and Groq credential encryption.
# Use exactly 32 random bytes encoded as 64 hex characters or base64.
APP_ENCRYPTION_KEY=

# Optional code judge (Judge0-compatible)
JUDGE0_URL=
JUDGE0_API_KEY=
JUDGE0_API_HOST=

# Optional legacy cron endpoint protection
CRON_SECRET=

# Solver settings
DEFAULT_LANGUAGE=java
MAX_REPAIR_ATTEMPTS=2
MAX_SUBMISSION_ATTEMPTS=3
